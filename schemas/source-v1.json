{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retroarchivebox.invalid/schemas/source-v1.json",
  "title": "RAB source policy v1",
  "type": "object",
  "required": ["id", "name", "class", "backend", "bulk_acquisition", "rights_default"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string"},
    "class": {"enum": ["MIRROR", "COOPERATIVE_MIRROR", "ARCHIVE_COLLECTION", "PRESERVATION_DATABASE", "HISTORICAL_MIRROR", "INGEST", "PHYSICAL_MEDIA"]},
    "backend": {"enum": ["rsync", "http", "https", "ftp", "bittorrent", "manual", "physical-media", "archive-org-targeted"]},
    "bulk_acquisition": {"enum": ["allowed", "permission-required", "targeted-only", "prohibited"]},
    "rights_default": {"enum": ["REDISTRIBUTABLE", "PRIVATE_LICENSED", "RESTRICTED", "UNKNOWN"]},
    "location": {"type": "string"},
    "enabled": {"type": "boolean"},
    "mirror_authorized": {"type": "boolean"},
    "platforms": {"type": "array", "items": {"type": "string"}},
    "schedule": {"type": "string"},
    "concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
    "rate_limit_bytes_per_second": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "retries": {"type": "integer", "minimum": 0},
    "companion_rules": {"type": "object"},
    "metadata_rules": {"type": "object"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
