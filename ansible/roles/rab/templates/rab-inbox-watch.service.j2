[Unit]
Description=Retro Archive Box watched inbox ingest
After=local-fs.target

[Service]
Type=simple
User={{ rab_user }}
Group={{ rab_group }}
Environment=RAB_ROOT={{ rab_root }}
Environment=RAB_AVBOX_ENABLED={{ rab_avbox_enabled | ternary('true', 'false') }}
Environment="RAB_AVBOX_URL={{ rab_avbox_url }}"
Environment="RAB_AVBOX_TOKEN_FILE={{ rab_avbox_token_file }}"
Environment="RAB_AVBOX_TIMEOUT={{ rab_avbox_timeout }}"
{% if rab_avbox_ca_bundle %}Environment="RAB_AVBOX_CA_BUNDLE={{ rab_avbox_ca_bundle }}"
{% endif %}
ExecStart=/opt/rab/venv/bin/rab --root {{ rab_root }} local-ingest inbox watch --loop --interval {{ rab_inbox_scan_interval_seconds }} --stability {{ rab_inbox_stability_seconds }} --min-age {{ rab_inbox_min_age_seconds }} --post-success {{ rab_inbox_post_success }}
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ rab_root }}
RestrictAddressFamilies=AF_UNIX{% if rab_avbox_enabled %} AF_INET AF_INET6{% endif %}
Restart=on-failure
RestartSec=5s
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
