[Unit]
Description=Retro Archive Box server-rendered web interface
After=local-fs.target

[Service]
Type=simple
User={{ rab_user }}
Group={{ rab_group }}
Environment=RAB_AVBOX_ENABLED={{ rab_avbox_enabled | ternary('true', 'false') }}
Environment="RAB_AVBOX_URL={{ rab_avbox_url }}"
Environment="RAB_AVBOX_TOKEN_FILE={{ rab_avbox_token_file }}"
Environment="RAB_AVBOX_TIMEOUT={{ rab_avbox_timeout }}"
{% if rab_avbox_ca_bundle %}Environment="RAB_AVBOX_CA_BUNDLE={{ rab_avbox_ca_bundle }}"
{% endif %}
ExecStart=/opt/rab/venv/bin/rab --root {{ rab_root }} --sources {{ rab_sources_dir }} web --host {{ rab_web_host }} --port {{ rab_web_port }}
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths={{ rab_root }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure

[Install]
WantedBy=multi-user.target
