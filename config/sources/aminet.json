{
  "id": "aminet",
  "name": "Aminet",
  "class": "COOPERATIVE_MIRROR",
  "backend": "http",
  "bulk_acquisition": "allowed",
  "enabled": false,
  "mirror_authorized": true,
  "rights_default": "UNKNOWN",
  "location": "http://de.aminet.net/aminet/",
  "platforms": ["Amiga"],
  "schedule": "weekly",
  "concurrency": 2,
  "timeout_seconds": 120,
  "retries": 3,
  "allow_redirects": false,
  "rate_limit_bytes_per_second": 262144,
  "minimum_free_space_bytes": 67108864,
  "companion_rules": {"payload_suffix": ".lha", "required_suffix": ".readme"},
  "metadata_rules": {"format": "aminet-readme", "preserve_original": true},
  "notes": "A package is incomplete unless both payload and original .readme are preserved. Confirm current operator policy before production acquisition."
}
